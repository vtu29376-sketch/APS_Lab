class MyCircularDeque {

    private final int[] deque;
    private final int k;
    private int front;
    private int rear;
    private int size;

    public MyCircularDeque(int k) {
        this.k = k;
        deque = new int[k];
        front = 0;
        rear = 0;
        size = 0;
    }

    public boolean insertFront(int value) {
        if (size == k) {
            return false;
        }

        front = (front - 1 + k) % k;
        deque[front] = value;
        size++;

        return true;
    }

    public boolean insertLast(int value) {
        if (size == k) {
            return false;
        }

        deque[rear] = value;
        rear = (rear + 1) % k;
        size++;

        return true;
    }

    public boolean deleteFront() {
        if (size == 0) {
            return false;
        }

        front = (front + 1) % k;
        size--;

        return true;
    }

    public boolean deleteLast() {
        if (size == 0) {
            return false;
        }

        rear = (rear - 1 + k) % k;
        size--;

        return true;
    }

    public int getFront() {
        return size == 0 ? -1 : deque[front];
    }

    public int getRear() {
        if (size == 0) {
            return -1;
        }

        return deque[(rear - 1 + k) % k];
    }

    public boolean isEmpty() {
        return size == 0;
    }

    public boolean isFull() {
        return size == k;
    }
}
